# Dockerfile — Blackwell Multi-Model Inference Server
# Supports: Qwen3-8B INT4 (56 t/s), Llama 3.2 1B, Llama 3.1 8B
# Weights + tokenizers mounted as volumes at runtime
#
# Build:
#   docker build -f Dockerfile.int4 -t blackwell-server:int4 .
#
# Run Qwen3-8B INT4:
#   docker run --gpus all -p 8080:8080 \
#     -v /mnt/data/ai/models/qwen3-8b-int4:/app/weights_int4_qwen3_8b \
#     -v /mnt/data/ai/models/qwen3-8b-int4/tokenizer_data.bin:/app/tokenizer_data.bin \
#     blackwell-server:int4 8080 int4_8b
#
# Run Llama 3.2 1B:
#   docker run --gpus all -p 8080:8080 \
#     -v /mnt/data/ai/models/llama32-1b-int4-from-safetensors:/app/weights_llama32_1b \
#     -v /mnt/data/ai/models/llama32-1b-int4-from-safetensors/tokenizer_data.bin:/app/tokenizer_data_llama.bin \
#     blackwell-server:int4 8080 llama32-1b

FROM ubuntu:24.04

LABEL description="Blackwell Multi-Model — RTX 5060 Ti, Qwen3-8B + Llama"
LABEL version="0.10.0"

# v0.10.0 features:
# - Fixed tokenizer byte encoder (GGUF converter bug: bytes 127+ had duplicate codepoints)
# - Regenerated weights with quantize_generic.py (not GGUF bridge — double quantization error)
# - Rate limiting (60 req/s per endpoint)
# - Graceful shutdown (SIGINT/SIGTERM)

RUN apt-get update \
    -o Acquire::Check-Valid-Until=false \
    -o Acquire::Check-Date=false \
    -o Acquire::AllowInsecureRepositories=true \
    -o Acquire::AllowDowngradeToInsecureRepositories=true && \
    apt-get install -y --allow-unauthenticated --no-install-recommends \
    ca-certificates curl && rm -rf /var/lib/apt/lists/*

# Copy CUDA runtime library from host
COPY cuda-libs/libcudart.so.13* /usr/local/lib/
RUN ln -sf /usr/local/lib/libcudart.so.13 /usr/local/lib/libcudart.so

WORKDIR /app

# Binaries (weights + tokenizers mounted from host at runtime)
COPY server/http_subprocess server/inference_server_int4 server/inference_server_llama /app/server/

RUN ldconfig || true

EXPOSE 8080
ENV CUDA_VISIBLE_DEVICES=0

ENTRYPOINT ["/app/server/http_subprocess"]
# Models: int4_8b (Qwen3-8B), llama32-1b, llama31-8b
CMD ["8080", "int4_8b"]